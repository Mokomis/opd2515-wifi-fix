diff --git a/crates/punktfunk-core/src/frame_diagnostic.rs b/crates/punktfunk-core/src/frame_diagnostic.rs
new file mode 100644
index 000000000..01fb4579e
--- /dev/null
+++ b/crates/punktfunk-core/src/frame_diagnostic.rs
@@ -0,0 +1,84 @@
+//! Bounded frame handoff records for the temporary diagnostic build.
+
+use std::collections::VecDeque;
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+const CAPACITY: usize = 4096;
+const WINDOW: Duration = Duration::from_secs(180);
+
+#[derive(Clone, Copy)]
+struct Entry {
+    stage: &'static str,
+    frame: u32,
+    pts_ns: u64,
+    complete: bool,
+    us: u64,
+}
+
+struct Ledger {
+    start: Instant,
+    entries: VecDeque<Entry>,
+}
+
+fn ledger() -> &'static Mutex<Ledger> {
+    static LEDGER: OnceLock<Mutex<Ledger>> = OnceLock::new();
+    LEDGER.get_or_init(|| {
+        Mutex::new(Ledger {
+            start: Instant::now(),
+            entries: VecDeque::with_capacity(CAPACITY),
+        })
+    })
+}
+
+/// Record a frame boundary for three minutes without retaining packet contents.
+pub(crate) fn record(stage: &'static str, frame: u32, pts_ns: u64, complete: bool) {
+    let Ok(mut l) = ledger().lock() else { return };
+    let elapsed = l.start.elapsed();
+    if elapsed > WINDOW {
+        return;
+    }
+    if l.entries.len() == CAPACITY {
+        l.entries.pop_front();
+    }
+    l.entries.push_back(Entry {
+        stage,
+        frame,
+        pts_ns,
+        complete,
+        us: elapsed.as_micros() as u64,
+    });
+}
+
+/// Emit recent boundaries for the recovery range and two neighboring indices.
+pub(crate) fn recovery(first: u32, last: u32) {
+    let entries = {
+        let Ok(l) = ledger().lock() else { return };
+        if l.start.elapsed() > WINDOW {
+            return;
+        }
+        let width = last.wrapping_sub(first).saturating_add(4);
+        l.entries
+            .iter()
+            .filter(|e| e.frame.wrapping_sub(first.wrapping_sub(2)) <= width)
+            .take(96)
+            .copied()
+            .collect::<Vec<_>>()
+    };
+    tracing::info!(
+        first,
+        last,
+        entries = entries.len(),
+        "frame ledger recovery"
+    );
+    for e in entries {
+        tracing::info!(
+            stage = e.stage,
+            frame = e.frame,
+            pts_ns = e.pts_ns,
+            complete = e.complete,
+            mono_us = e.us,
+            "frame ledger"
+        );
+    }
+}
