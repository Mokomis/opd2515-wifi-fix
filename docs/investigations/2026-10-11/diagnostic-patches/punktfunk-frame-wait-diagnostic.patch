+//! Bounded frame handoff records for the temporary diagnostic build.
+
+use std::collections::VecDeque;
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+const CAPACITY: usize = 4096;
+const WINDOW: Duration = Duration::from_secs(180);
+
+#[derive(Clone, Copy)]
+struct Entry {
+    stage: &'static str,
+    frame: u32,
+    pts_ns: u64,
+    complete: bool,
+    us: u64,
+}
+
+struct Ledger {
+    start: Instant,
+    entries: VecDeque<Entry>,
+}
+
+fn ledger() -> &'static Mutex<Ledger> {
+    static LEDGER: OnceLock<Mutex<Ledger>> = OnceLock::new();
+    LEDGER.get_or_init(|| {
+        Mutex::new(Ledger {
+            start: Instant::now(),
+            entries: VecDeque::with_capacity(CAPACITY),
+        })
+    })
+}
+
+/// Record a frame boundary for three minutes without retaining packet contents.
+pub fn record(stage: &'static str, frame: u32, pts_ns: u64, complete: bool) {
+    let Ok(mut l) = ledger().lock() else { return };
+    let elapsed = l.start.elapsed();
+    if elapsed > WINDOW {
+        return;
+    }
+    if l.entries.len() == CAPACITY {
+        l.entries.pop_front();
+    }
+    l.entries.push_back(Entry {
+        stage,
+        frame,
+        pts_ns,
+        complete,
+        us: elapsed.as_micros() as u64,
+    });
+}
+
+/// Emit recent boundaries for the recovery range and two neighboring indices.
+pub(crate) fn recovery(first: u32, last: u32) {
+    let entries = {
+        let Ok(l) = ledger().lock() else { return };
+        if l.start.elapsed() > WINDOW {
+            return;
+        }
+        let width = last.wrapping_sub(first).saturating_add(4);
+        l.entries
+            .iter()
+            .filter(|e| e.frame.wrapping_sub(first.wrapping_sub(2)) <= width)
+            .take(96)
+            .copied()
+            .collect::<Vec<_>>()
+    };
+    tracing::info!(
+        first,
+        last,
+        entries = entries.len(),
+        "frame ledger recovery"
+    );
+    for e in entries {
+        tracing::info!(
+            stage = e.stage,
+            frame = e.frame,
+            pts_ns = e.pts_ns,
+            complete = e.complete,
+            mono_us = e.us,
+            "frame ledger"
+        );
+    }
+}
+
+
+struct Timing {
+    frame: u32,
+    start: Instant,
+    marks: Vec<(&'static str, u64)>,
+}
+
+thread_local! {
+    static TIMING: std::cell::RefCell<Option<Timing>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Start one decode-lane timing record without retaining video contents.
+pub fn begin(frame: u32) {
+    TIMING.with(|t| *t.borrow_mut() = Some(Timing {
+        frame, start: Instant::now(), marks: Vec::with_capacity(12),
+    }));
+}
+
+/// Timestamp a decode-lane boundary against its current frame handoff.
+pub fn mark(stage: &'static str) {
+    TIMING.with(|t| {
+        if let Some(t) = t.borrow_mut().as_mut() {
+            t.marks.push((stage, t.start.elapsed().as_micros() as u64));
+        }
+    });
+}
+
+/// Emit one completed frame's relative boundaries during the diagnostic window.
+pub fn finish(shown: bool) {
+    let active = ledger().lock().map(|l| l.start.elapsed() <= WINDOW).unwrap_or(false);
+    TIMING.with(|t| {
+        if let Some(t) = t.borrow_mut().take().filter(|_| active) {
+            let marks = t.marks.iter().map(|(stage, us)| format!("{stage}:{us}"))
+                .collect::<Vec<_>>().join(",");
+            tracing::info!(frame=t.frame, shown, marks, total_us=t.start.elapsed().as_micros() as u64,
+                "frame timing");
+        }
+    });
+}
